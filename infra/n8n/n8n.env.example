# n8n auf Hetzner – DSGVO Log-Pruning (.env-Vorgabe)
# Datei: /opt/n8n/.env (bestehende Secrets nicht überschreiben, nur ergänzen)

EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Telegram – Routing Nils (Ops) / Stefan (Vertrieb)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NILS_CHAT_ID=
TELEGRAM_STEFAN_CHAT_ID=
# Fallback wenn oben leer:
TELEGRAM_OWNER_CHAT_ID=

# Agency Brain (n8n → /api/agency/brain)
CRON_SECRET=
AGENCY_ADMIN_PASSWORD=

# CRM Webhook (Status „Signiert“)
CRM_STATUS_WEBHOOK_URL=https://digitalehandwerkskunst.de/api/agency/crm/status
