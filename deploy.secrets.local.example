# Kopieren nach deploy.secrets.local (wird NICHT committed)
# Alter Mini-Server (Shop, 2 GB) – nicht für Voice-Stack
SERVER_HOST=167.233.211.170
SERVER_USER=root
SERVER_PASSWORD=dein-root-passwort-hier

# Neue CX33 / CPX (nach Bestellung eintragen) – Voice-Install läuft hier
# WEB_HOST=x.x.x.x
# AUTO_HOST=y.y.y.y
# VOICE_HOST=   # optional; Standard = AUTO_HOST, sonst WEB_HOST
# WEB_PASSWORD=   # optional, sonst SERVER_PASSWORD
# AUTO_PASSWORD=
# VOICE_PASSWORD=

# ── Agency-E-Mail (Onboarding, Rechnungen — von Webschmiede an Kunden) ────────
# Beispiele: Zoho Mail, Google Workspace, Microsoft 365, Hetzner Mail
AGENCY_SMTP_HOST=smtp.zoho.eu
AGENCY_SMTP_PORT=587
AGENCY_SMTP_USER=onboarding@webschmiede.de
AGENCY_SMTP_PASS=dein-mail-passwort
AGENCY_SMTP_FROM=Webschmiede <onboarding@webschmiede.de>
AGENCY_REPLY_TO=support@webschmiede.de
# Kopie jeder ausgehenden Kunden-Mail (BCC)
AGENCY_MAIL_BCC=christian.kummetat@gmail.com

# ── Agency Admin (Seminare) ───────────────────────────────────────────────────
AGENCY_ADMIN_PASSWORD=dein-agency-admin-passwort
AGENCY_OWNER_EMAIL=you@webschmiede.de
# Optional: Google Business Manager-Einladung (sonst AGENCY_OWNER_EMAIL)
AGENCY_GOOGLE_MANAGER_EMAIL=

# ── Google Places (optional — Akquise-Krieger) ────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── Firecrawl (optional — Nils Deep Research) ─────────────────────────────────
FIRECRAWL_API_KEY=

# ── Meta Ad Library (optional — Werbe-Signal) ─────────────────────────────────
# Meta Developer App Token mit ads_read — sonst Fallback HTML-Scan
META_AD_LIBRARY_TOKEN=

# ── North Data (optional — GF / Handelsregister) ──────────────────────────────
NORTHDATA_API_KEY=

# ── Stripe (Agency-Abrechnung: Setup + Abo) ───────────────────────────────────
# Test: sk_test_… · Live: sk_live_…
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Off-Server Backup (Hetzner Storage Box, optional) ───────────────────────
# Ordner „backups“ auf der Storage Box anlegen
BACKUP_SFTP_HOST=
BACKUP_SFTP_USER=
BACKUP_SFTP_PASS=
BACKUP_SFTP_PATH=backups

SHY001_SMS_API_KEY=
SHY001_OWNER_PHONE=+49
SHY001_GOOGLE_REVIEW_URL=https://g.page/r/...

# ── Domains (IONOS Hosting API — DNS) ───────────────────────────────────────
# developer.hosting.ionos.de → API Keys · Präfix + Secret (nie im Chat)
IONOS_API_PREFIX=
IONOS_API_SECRET=

# ── Domains (INWX — Kauf .de + DNS, empfohlen) ───────────────────────────────
# Account: https://www.inwx.de · Kontakt unter Domains → Kontakte anlegen
INWX_USER=
INWX_PASSWORD=
INWX_CONTACT_ID=
# INWX_OTE=1   # nur Test-API
# DOMAIN_AUTO_PURCHASE=1   # nur wenn Christian Auto-Kauf will

# ── Domains (Cloudflare, optional) ──────────────────────────────────────────
# Custom Token: Zone/DNS/Zone Settings Edit · Account ID im Dashboard rechts
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# TourMeter Spritpreise (kostenloser Key)
# https://creativecommons.tankerkoenig.de/
TANKERKOENIG_API_KEY=

# ── Hetzner Cloud API ───────────────────────────────────────────────────────
# console.hetzner.cloud → Security → API Tokens (Read & Write)
HETZNER_API_TOKEN=

# ── LLM Gateway (Requesty + OpenAI Fallback) ────────────────────────────────
# Oder separat in requesty.secrets.local (wird mit deploy hochgeladen)
PRIMARY_LLM_GATEWAY=https://router.eu.requesty.ai/v1
PRIMARY_API_KEY=
PRIMARY_LLM_MODEL=azure/gpt-4o-mini@swedencentral
FALLBACK_OPENAI_GATEWAY=https://api.openai.com/v1
FALLBACK_OPENAI_KEY=
