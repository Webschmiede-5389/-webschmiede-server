# # NILS_ROUTE_B_MODELS=primary:bedrock/claude-sonnet-4@eu-central-1,primary:vertex/claude-sonnet-5@eu,primary:tensorx/deepseek-v4-pro
# # NILS_ROUTE_C_MODELS=primary:azure/gpt-4o-mini@swedencentral,primary:bedrock/claude-sonnet-4@eu-central-1
