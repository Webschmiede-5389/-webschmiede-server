{
  "name": "Agency 09 – Nils Infra",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "09-cron",
      "name": "Zeitplan",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://digitalehandwerkskunst.de/api/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Secret",
              "value": "={{$env.CRON_SECRET}}"
            },
            {
              "name": "X-Agency-Password",
              "value": "={{$env.AGENCY_ADMIN_PASSWORD}}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "09-http",
      "name": "Agency API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j=$input.first().json;\nreturn [{ json: { ok: true, workflow: 'nils', note: \"Bestehend: workflow-healthcheck + nightly_watchdog. Skill nils.\", result: j } }];"
      },
      "id": "09-pack",
      "name": "Ergebnis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Zeitplan": {
      "main": [
        [
          {
            "node": "Agency API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agency API": {
      "main": [
        [
          {
            "node": "Ergebnis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "notes": "Bestehend: workflow-healthcheck + nightly_watchdog. Skill nils."
  },
  "tags": [
    {
      "name": "agency"
    },
    {
      "name": "system-13"
    },
    {
      "name": "nils"
    }
  ]
