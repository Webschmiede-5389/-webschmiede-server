{
  "name": "Webschmiede – DB Backup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 3 * * *" }]
        }
      },
      "id": "cron-backup",
      "name": "Täglich 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/cron/backup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Cron-Secret", "value": "={{ $env.CRON_SECRET }}" }
          ]
        },
        "options": {}
      },
      "id": "http-backup",
      "name": "Backup auslösen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Täglich 03:00": {
      "main": [[{ "node": "Backup auslösen", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
