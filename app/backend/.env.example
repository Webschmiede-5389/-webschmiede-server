# ── Portal (gastro | handwerk) ───────────────────────────────────────────────
PORTAL_MODE=gastro
KUNDE_ID=SHY001

# ── Lexware Office (pro Kunde, optional) ────────────────────────────────────
# Key in Lexware: Einstellungen → Public API → Schlüssel erzeugen
# LEXWARE_API_KEY_SHY001=
# LEXWARE_API_KEY=

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=dein-sicheres-passwort

# ── GHL (optional – standardmäßig AUS) ─────────────────────────────────────
GHL_ENABLED=false
GHL_TOKEN=
GHL_LOC_ID=
GHL_PIPELINE_ID=
GHL_STAGE_NEW=

# ── E-Mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bestellung@snackhouse-mechernich.de

# ── SMS via seven.io (https://www.seven.io) ─────────────────────────────────
SMS_ENABLED=false
SMS_API_KEY=dein-seven-io-api-key
SMS_SENDER=SnackHouse
OWNER_PHONE=+491751234567
SHOP_NAME=Snack House Yassine
SHOP_PHONE=024433088966

# ── WhatsApp Cloud API (Meta) – GHL-Ersatz ──────────────────────────────────
# Meta Developers → App → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=webschmiede-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional
# WHATSAPP_DISPLAY_PHONE=+49…
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_APP_ID=
# META_APP_SECRET=
# META_EMBEDDED_CONFIG_ID=

# ── Telegram Ops (Christian ↔ Nils, intern) ─────────────────────────────────
# @BotFather → /newbot · Doku: docs/agency/telegram-ops.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# ── KI (Nils Telegram/WhatsApp Chat) ────────────────────────────────────────
# LLM_PROVIDER=auto          # ollama zuerst (gratis)
# LLM_PROVIDER=cloud         # OpenRouter/Grok/OpenAI/Gemini zuerst (bezahlt)
# NILS_DISPATCHER=1          # Smart-Router A/B/C (Standard an)
# NILS_STRIP_PII=1           # Maskiert IBAN/Mail/Telefon vor Cloud
# OLLAMA_URL=http://AUTO_HOST:11434
# OLLAMA_MODEL=qwen2.5:14b
# # Primäres Gateway Requesty EU (Frankfurt) – bezahlt, nur nach OK
# PRIMARY_LLM_GATEWAY=https://router.eu.requesty.ai/v1
# PRIMARY_API_KEY=
# PRIMARY_LLM_MODEL=azure/gpt-4o-mini@swedencentral
# REQUESTY_CHAT_MODEL=nebius/meta-llama/Llama-3.3-70B-Instruct
# REQUESTY_SMART_MODEL=bedrock/claude-sonnet-4@eu-central-1
# REQUESTY_VISION_MODEL=azure/gpt-4o-mini@swedencentral
# REQUESTY_IMAGE_MODEL=azure/openai/gpt-image-1
# LLM_CONNECT_TIMEOUT=5
# NILS_TG_STREAM=1
# NILS_TG_STREAM_MS=400
# # Fallback Direkt-OpenAI (Notfall, AVV)
# FALLBACK_OPENAI_GATEWAY=https://api.openai.com/v1
# FALLBACK_OPENAI_KEY=
# OPENAI_API_KEY=            # Alias zu FALLBACK_OPENAI_KEY
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=        # optional zweites Gateway
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_SITE_URL=https://digitalehandwerkskunst.de
# OPENROUTER_APP_NAME=Webschmiede-Nils
