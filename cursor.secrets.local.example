# Vorlage: nach cursor.secrets.local kopieren (gitignored) oder Keys in requesty.secrets.local.
# Cursor Dashboard -> API Keys / Integrations -> User API Key

CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/Webschmiede-5389/-webschmiede-server.git
CURSOR_REPO_REF=main
CURSOR_AGENT_MODEL=composer-2.5
NILS_CURSOR_BRIDGE=1
# Nach Cursor-Freigabe: Live-Pull auf web-01 (Repo read)
NILS_CURSOR_AUTO_DEPLOY=1
GITHUB_TOKEN=
# Akquise-Nacht pausiert bis du OK gibst (Places-Kosten). Wieder an: 0 + Cron neu.
NILS_PAUSE_AKQUISE_AUTO=1
