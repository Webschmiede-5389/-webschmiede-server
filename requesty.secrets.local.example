# Vorlage: nach requesty.secrets.local kopieren und Keys eintragen.
# requesty.secrets.local wird NICHT committed.

# Primäres Gateway (Requesty EU – Frankfurt)
PRIMARY_LLM_GATEWAY=https://router.eu.requesty.ai/v1
PRIMARY_API_KEY=
PRIMARY_LLM_MODEL=azure/gpt-4o-mini@swedencentral

# Route-Modelle (EU-Inference wo möglich)
# NILS_ROUTE_A_MODELS=primary:nebius/meta-llama/Llama-3.3-70B-Instruct,primary:tensorx/deepseek-v4-flash,...
REQUESTY_IMAGE_MODEL=azure/openai/gpt-image-1
REQUESTY_VISION_MODEL=azure/gpt-4o-mini@swedencentral
REQUESTY_SMART_MODEL=bedrock/claude-sonnet-4@eu-central-1
REQUESTY_CHAT_MODEL=nebius/meta-llama/Llama-3.3-70B-Instruct

# Telegram Streaming
NILS_CLOUD_FIRST=1
NILS_STT_CLOUD_FIRST=0
NILS_TG_STREAM=0
NILS_TG_STREAM_MS=300
NILS_REQUESTY_DAILY_BUDGET=8
NILS_REQUESTY_MONTHLY_BUDGET=20
NILS_IMAGE_MAX_PER_DAY=5
NILS_IMAGE_AUTO=0
NILS_PAID_MEDIA_CONFIRM=1
NILS_BUDGET_GUARD_CHAT=0

FALLBACK_OPENAI_GATEWAY=https://api.openai.com/v1
FALLBACK_OPENAI_KEY=
